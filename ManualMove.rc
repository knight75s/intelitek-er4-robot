// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\ManualMove.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 235, 55
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About ManualMove"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "ManualMove Version 1.03",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2001",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
END

IDD_MANUALMOVE_DIALOG DIALOGEX 0, 0, 228, 177
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Manual Movement"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "Axis",IDC_STATIC,4,70,220,100
    CONTROL         "1 - &Base",IDC_RADIO_AXIS_1,"Button",BS_AUTORADIOBUTTON | 
                    WS_GROUP,13,79,52,10
    CONTROL         "2 - &Shoulder",IDC_RADIO_AXIS_2,"Button",
                    BS_AUTORADIOBUTTON,13,95,52,10
    CONTROL         "3 - &Elbow",IDC_RADIO_AXIS_3,"Button",
                    BS_AUTORADIOBUTTON,69,79,52,10
    CONTROL         "4 - &Pitch",IDC_RADIO_AXIS_4,"Button",
                    BS_AUTORADIOBUTTON,69,95,52,10
    CONTROL         "5 - Ro&ll",IDC_RADIO_AXIS_5,"Button",BS_AUTORADIOBUTTON,
                    125,79,52,10
    CONTROL         "6 - &Gripper",IDC_RADIO_AXIS_6,"Button",
                    BS_AUTORADIOBUTTON,125,95,52,10
    PUSHBUTTON      "&Plus",IDC_BUTTON_PLUS,53,114,58,14
    PUSHBUTTON      "&Minus",IDC_BUTTON_MINUS,119,114,58,14
    PUSHBUTTON      "&Open Gripper",IDC_BUTTON_OPEN_GROPPER,51,148,60,14
    PUSHBUTTON      "&Close Gripper",IDC_BUTTON_CLOSE_GROPPER,117,148,60,14
    PUSHBUTTON      "&On-Line",IDM_INIT,19,14,54,16
    PUSHBUTTON      "Control O&n",IDM_CON,96,16,54,16
    PUSHBUTTON      "Control O&ff",IDM_COFF,154,16,54,16
    LTEXT           "Speed:",IDC_STATIC,187,79,26,10
    COMBOBOX        IDC_COMBO_SPEED,187,92,26,60,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Controller",IDC_STATIC,4,2,220,67
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,138,211,1
    EDITTEXT        IDC_EDIT_MODE,19,50,54,12,ES_CENTER | ES_AUTOHSCROLL | 
                    ES_READONLY
    EDITTEXT        IDC_EDIT_CON_OFF,95,50,112,12,ES_CENTER | ES_AUTOHSCROLL | 
                    ES_READONLY
    PUSHBUTTON      "&Simulation",IDM_INIT2,19,33,54,16
END


